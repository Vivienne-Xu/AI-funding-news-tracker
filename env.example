# Copy this file to a new file named ".env" and fill in the values. Never share ".env".

# --- AI model: Google Gemini (needed from Phase 3) ---
# Free key: aistudio.google.com -> "Get API key" -> "Create API key"
GEMINI_API_KEY=
# Model for the daily extraction. Change here if you want a different Gemini model.
LLM_MODEL_FAST=gemini-3.5-flash-lite
# Model for the monthly report commentary (one call a month). Free on Google's free tier.
LLM_MODEL_WRITER=gemini-3.5-flash-lite

# --- Spending caps in US dollars (only relevant if you switch to a paid Gemini plan) ---
MAX_DAILY_LLM_USD=0.25
MAX_MONTHLY_LLM_USD=3.00

# --- Email (needed from Phase 5) ---
# Free key: resend.com -> sign up -> API Keys -> Create API Key
RESEND_API_KEY=
# Sender. While testing without your own domain, use: onboarding@resend.dev
EMAIL_FROM=
# Who receives the briefing. One address, or several separated by commas.
# Without a verified domain, Resend only delivers to the address you signed up with.
EMAIL_TO=
# On a day with no deals: true = send a short "quiet day" note, false = send nothing.
SEND_QUIET_DAY_NOTE=true

# --- Where the database file lives ---
DB_PATH=data/funding.db
